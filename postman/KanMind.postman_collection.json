  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('token');",
          "if (token) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Token ' + token",
          "  });",
          "}"
        ]
